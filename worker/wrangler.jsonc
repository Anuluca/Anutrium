{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anutrium-steam-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "steam-api.anuluca.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "STEAM_ID": "76561198287023366",
    "STEAM_VANITY": "anuluca",
    "GITHUB_USERNAME": "Anuluca",
    "ALLOWED_ORIGINS": "https://anuluca.com,https://www.anuluca.com,http://localhost:3000,http://127.0.0.1:3000",
    "CACHE_TTL_SECONDS": "900",
    "GITHUB_CACHE_TTL_SECONDS": "21600"
  },
  "secrets": {
    "required": ["STEAM_API_KEY", "GITHUB_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
