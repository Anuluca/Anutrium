{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anutrium-steam-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "steam-api.anuluca.com",
      "custom_domain": true
    }
  ],
  "r2_buckets": [{ "binding": "FLORATRIUM_BUCKET", "bucket_name": "anutrium" }],
  "durable_objects": {
    "bindings": [{ "name": "FLORA_LIKES", "class_name": "FloraLikes" }]
  },
  "migrations": [
    { "tag": "flora-likes-v1", "new_sqlite_classes": ["FloraLikes"] }
  ],
  "vars": {
    "GA4_PROPERTY_ID": "353411419",
    "GA4_STREAM_ID": "4620543849",
    "STEAM_ID": "76561198287023366",
    "STEAM_VANITY": "anuluca",
    "GITHUB_USERNAME": "Anuluca",
    "ALLOWED_ORIGINS": "https://anuluca.com,https://www.anuluca.com,http://localhost:3000,http://127.0.0.1:3000",
    "CACHE_TTL_SECONDS": "900",
    "GITHUB_CACHE_TTL_SECONDS": "21600"
  },
  "secrets": {
    "required": [
      "STEAM_API_KEY",
      "GITHUB_TOKEN",
      "GA4_SERVICE_ACCOUNT_JSON",
      "HOME_FEATURES_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
