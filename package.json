{
  "name": "anulucaicu-mega",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run lint && vite --host",
    "build": "npm run lint && run-p build-only",
    "preview": "vite preview",
    "build-only": "yarn check:fonts && yarn build:map-data && vite-ssg build",
    "type-check": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install",
    "test:performance": "yarn build-only && playwright test --config=playwright.performance.config.ts",
    "build:temple-labels": "node scripts/build-temple-labels.mjs",
    "build:lucario-model": "node scripts/build-lucario-model.mjs",
    "build:sprigatito-model": "node scripts/build-sprigatito-model.mjs",
    "optimize:model-assets": "node scripts/optimize-model-assets.mjs",
    "build:fonts": "python3 scripts/build-unbounded-fonts.py",
    "check:fonts": "node scripts/check-unbounded-fonts.mjs",
    "check:fonts:remote": "node scripts/check-fonts-remote.mjs",
    "upload:fonts": "node scripts/upload-unbounded-fonts.mjs",
    "build:map-data": "node scripts/build-travel-boundaries.mjs",
    "check:overlay-scroll": "node scripts/check-overlay-scroll-lock.mjs",
    "test:overlay-scroll": "playwright test tests/modal-scroll-lock.spec.ts tests/page-footer.spec.ts --grep preserves",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore && node scripts/check-overlay-scroll-lock.mjs",
    "format": "prettier --write src/",
    "build:flora-pets": "node scripts/build-flora-pets.mjs"
  },
  "engines": {
    "node": "24.12.0",
    "yarn": "1.22.22"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "@vueuse/core": "^10.11.1",
    "@vueuse/head": "^2.0.0",
    "element-plus": "^2.2.33",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.19.1",
    "leaflet": "1.9.4",
    "lenis": "^1.3.23",
    "markdown-it": "14.3.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "meshoptimizer": "1.3.0",
    "nprogress": "^0.2.0",
    "pinia": "^2.0.32",
    "qrcode": "^1.5.4",
    "reset-css": "^5.0.1",
    "three": "^0.182.0",
    "vue": "^3.2.47",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.1.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/leaflet": "1.9.21",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^18.14.2",
    "@types/nprogress": "^0.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.2",
    "@vue/tsconfig": "^0.1.3",
    "critters": "0.0.24",
    "eslint": "^8.34.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^9.9.0",
    "jsqr": "^1.4.0",
    "less": "^4.1.3",
    "npm-run-all": "^4.1.5",
    "pngjs": "^7.0.0",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "^2.8.4",
    "terser": "^5.44.1",
    "typescript": "~4.8.4",
    "unplugin-auto-import": "^0.15.0",
    "unplugin-vue-components": "^0.24.0",
    "vite": "^4.1.4",
    "vite-plugin-pwa": "1.3.0",
    "vite-ssg": "0.23.8",
    "vue-tsc": "^1.2.0"
  }
}
