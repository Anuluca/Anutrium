VITE_STEAM_WORKER_URL=https://anutrium-steam-api.tilucario.workers.dev

# GA4 衡量 ID；正式环境启用，本地默认不采集。该 ID 是公开标识，不是密钥。
VITE_GA4_MEASUREMENT_ID=
VITE_GA4_ENABLE_DEV=false
VITE_GA4_DEBUG=false
# 本地直接读取线上统计接口；正式环境使用 Netlify 同源转发。
VITE_GA4_REPORTS_URL=https://steam-api.anuluca.com/analytics

# 开发时直连线上 Worker；生产默认走 Netlify 的同源转发。
VITE_HOME_FEATURES_URL=https://steam-api.anuluca.com/site/home-features

# 可选：花花小窝公开喜爱接口，生产默认使用 Netlify 同源转发。
VITE_FLORA_LIKES_URL=https://steam-api.anuluca.com/floratrium/likes

# 首页 3D 诊断：默认关闭；性能排查或专项测试构建时显式设为 true。
VITE_HOME_SCENE_DIAGNOSTICS=false

# 标签：lod 按屏幕尺寸选择 high/low/flat；也可固定为任一档位。
VITE_HOME_LABEL_QUALITY=lod
