VITE_STEAM_WORKER_URL=https://anutrium-steam-api.tilucario.workers.dev

# GA4 衡量 ID；正式环境启用，本地默认不采集。该 ID 是公开标识，不是密钥。
VITE_GA4_MEASUREMENT_ID=
VITE_GA4_ENABLE_DEV=false
VITE_GA4_DEBUG=false
# 本地直接读取线上统计接口；正式环境使用 Netlify 同源转发。
